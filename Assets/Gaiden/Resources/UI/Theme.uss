/* GridGame Gaiden — UI theme. Final Fantasy-style menus: blue gradient windows, white rounded frames,
   pointing-hand cursor rows, gold numbers. Every screen is built in C# from these classes. */

.stage {
    position: absolute;
    width: 1170px;
    height: 2532px;
    overflow: hidden;
    background-color: rgb(8, 10, 22);
    color: rgb(240, 242, 255);
    font-size: 40px;
}

.letterbox { background-color: rgb(4, 5, 12); }
/* Outline around the stage when the device is wider/taller than any supported phone (tablets): the bars read
   as a deliberate bezel around one big game window, in the same white rounded frame every window uses. */
.stage-frame {
    position: absolute;
    border-width: 5px;
    border-color: rgb(236, 238, 255);
    border-radius: 22px;
    background-color: rgb(0, 0, 0);
}

.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.center { align-items: center; justify-content: center; }
.hidden { display: none; }

/* ── Windows ─────────────────────────────────────────────────────────────── */
.window {
    border-width: 5px;
    border-color: rgb(236, 238, 255);
    border-radius: 18px;
    padding: 22px 28px;
    margin: 10px;
    background-size: 100% 100%;
    flex-shrink: 0;
}
/* A window holding a scrolling list (Ui.List): fills the space left over and scrolls instead of squashing the
   tabs and footers around it when its content runs long. */
.window--scroller { flex-shrink: 1; flex-basis: 0; min-height: 160px; }
.window--plain { background-color: rgba(10, 16, 52, 0.94); }
.window-title {
    font-size: 44px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 12px;
}
.window-sub { font-size: 34px; color: rgb(170, 184, 255); }

/* ── Text ────────────────────────────────────────────────────────────────── */
.title { font-size: 120px; color: rgb(255, 244, 214); -unity-text-align: middle-center; -unity-font-style: bold; }
.h1 { font-size: 64px; color: rgb(255, 255, 255); -unity-font-style: bold; }
.h2 { font-size: 48px; color: rgb(255, 255, 255); -unity-font-style: bold; }
.small { font-size: 32px; }
.tiny { font-size: 26px; }
.dim { color: rgb(150, 160, 205); }
.gold { color: rgb(255, 214, 92); }
.good { color: rgb(120, 236, 150); }
.bad { color: rgb(255, 110, 110); }
.warn { color: rgb(255, 196, 92); }
.shadow { text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.75); }
.num { -unity-text-align: middle-right; }

/* ── Menu rows (cursor hand) ─────────────────────────────────────────────── */
.menu-row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    padding: 6px 12px 6px 6px;
    border-radius: 10px;
    margin: 2px 0;
}
.menu-row:hover { background-color: rgba(255, 255, 255, 0.06); }
.menu-row--selected { background-color: rgba(140, 170, 255, 0.20); }
.menu-row--disabled { opacity: 0.42; }
.menu-cursor { width: 56px; height: 56px; margin-right: 8px; opacity: 0; background-size: contain; }
.menu-row--selected > .menu-cursor { opacity: 1; }
.menu-label { flex-grow: 1; font-size: 42px; }
.menu-value { font-size: 40px; -unity-text-align: middle-right; margin-left: 16px; }
.menu-icon { width: 64px; height: 64px; margin-right: 18px; background-size: contain; }

/* ── Buttons ─────────────────────────────────────────────────────────────── */
/* Every button stands on a darker lip (the thick bottom border). Pressing sinks it onto the lip. */
.btn {
    min-height: 104px;
    padding: 0 40px;
    margin: 8px;
    border-width: 4px;
    border-bottom-width: 12px;
    border-radius: 16px;
    border-color: rgb(236, 238, 255);
    border-bottom-color: rgb(120, 132, 196);
    background-color: rgb(34, 58, 150);
    color: rgb(255, 255, 255);
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.btn:hover { background-color: rgb(52, 84, 196); }
.btn--primary { background-color: rgb(196, 120, 24); border-color: rgb(255, 232, 170); border-bottom-color: rgb(150, 92, 30); }
.btn--primary:hover { background-color: rgb(226, 146, 40); }
.btn--danger { background-color: rgb(150, 30, 40); border-bottom-color: rgb(96, 18, 26); }
.btn--danger:hover { background-color: rgb(178, 40, 52); }

.role-badge {
    -unity-font-style: bold;
    border-width: 3px;
    border-radius: 10px;
    padding: 0 10px;
    margin: 0 8px;
    background-color: rgba(4, 6, 20, 0.75);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ── Shared press feel (Ui.Pressable): sink on touch, spring back on release ── */
.pressable {
    transition-property: scale, translate, background-color, border-bottom-width, opacity;
    transition-duration: 0.06s, 0.06s, 0.08s, 0.06s, 0.1s;
    transition-timing-function: ease-out;
}
.pressable.is-pressed { scale: 0.95 0.95; translate: 0 6px; }
.pressable.is-released { transition-duration: 0.14s; transition-timing-function: ease-out-back; }
.btn.is-pressed { border-bottom-width: 4px; translate: 0 8px; background-color: rgb(24, 40, 108); }
.btn--primary.is-pressed { background-color: rgb(150, 88, 14); }
.btn--danger.is-pressed { background-color: rgb(110, 20, 28); }
.menu-row.is-pressed { background-color: rgba(140, 170, 255, 0.34); translate: 4px 2px; scale: 0.985 0.985; }
.tab.is-pressed { translate: 0 4px; scale: 0.94 0.94; }
.card-tap.is-pressed { scale: 0.94 0.94; translate: 0 6px; }
.slot { transition-property: scale, translate, opacity; transition-duration: 0.07s, 0.07s, 0.15s; }
.slot--targeting { scale: 1.06 1.06; }
.slot.is-pressed { scale: 0.92 0.92; translate: 0 10px; }
.btn--disabled { opacity: 0.4; }
.btn--small { min-height: 80px; font-size: 34px; padding: 0 24px; border-bottom-width: 9px; }
.btn--small.is-pressed { border-bottom-width: 3px; translate: 0 6px; }
.btn--icon { width: 104px; padding: 0; }

/* ── Header bar ──────────────────────────────────────────────────────────── */
.header {
    flex-direction: row;
    align-items: center;
    height: 150px;
    padding: 0 20px;
    background-color: rgba(4, 8, 30, 0.85);
    border-bottom-width: 4px;
    border-color: rgb(236, 238, 255);
}
.header-title { flex-grow: 1; font-size: 56px; -unity-font-style: bold; -unity-text-align: middle-left; margin-left: 12px; }
.header-gold { font-size: 46px; color: rgb(255, 214, 92); -unity-text-align: middle-right; margin-right: 12px; }

/* ── Tabs ────────────────────────────────────────────────────────────────── */
.tabs { flex-direction: row; margin: 10px 10px 0 10px; flex-shrink: 0; }
.tab {
    flex-grow: 1;
    height: 96px;
    margin: 0 4px;
    border-width: 4px 4px 0 4px;
    border-color: rgb(236, 238, 255);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    background-color: rgb(18, 28, 84);
    font-size: 38px;
    -unity-text-align: middle-center;
    color: rgb(170, 184, 255);
}
.tab--active { background-color: rgb(40, 66, 170); color: rgb(255, 255, 255); -unity-font-style: bold; }

/* ── Gauges ──────────────────────────────────────────────────────────────── */
.gauge { height: 20px; border-radius: 10px; background-color: rgba(0, 0, 0, 0.6); border-width: 2px; border-color: rgba(255, 255, 255, 0.5); overflow: hidden; }
.gauge-fill { height: 100%; border-radius: 8px; background-color: rgb(110, 230, 120); }
.gauge-fill--mid { background-color: rgb(240, 200, 70); }
.gauge-fill--low { background-color: rgb(240, 80, 70); }

/* ── Toast / dialog ──────────────────────────────────────────────────────── */
.toast {
    position: absolute;
    left: 120px; right: 120px; bottom: 260px;
    padding: 26px 34px;
    border-radius: 18px;
    border-width: 4px;
    border-color: rgb(236, 238, 255);
    background-color: rgba(12, 18, 60, 0.96);
    font-size: 40px;
    -unity-text-align: middle-center;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}
.veil { background-color: rgba(0, 0, 0, 0.6); }

/* ── Fade overlay ────────────────────────────────────────────────────────── */
.fade { background-color: rgb(0, 0, 0); opacity: 0; transition-property: opacity; transition-duration: 0.22s; }
.fade--on { opacity: 1; }

/* ── Scroll views ────────────────────────────────────────────────────────── */
.list { flex-grow: 1; }
.list .unity-scroller--vertical { width: 18px; }
.list .unity-scroller__slider .unity-base-slider__dragger { background-color: rgba(236, 238, 255, 0.6); border-radius: 8px; }

/* ── Portrait card ───────────────────────────────────────────────────────── */
.card {
    flex-direction: row;
    align-items: center;
    padding: 14px;
    margin: 8px 0;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.05);
}
.card--selected { background-color: rgba(140, 170, 255, 0.22); }
.thumb {
    width: 150px; height: 150px;
    border-radius: 16px;
    border-width: 4px;
    border-color: rgb(236, 238, 255);
    background-color: rgb(30, 36, 70);
    background-size: cover;
    margin-right: 22px;
}

/* ── Battle unit frame — the same frame as .thumb, so battle and menus share one look ── */
.unit-frame {
    border-radius: 16px;
    border-width: 4px;
    border-color: rgb(236, 238, 255);
    overflow: hidden;
}
.unit-keyline { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-width: 4px; border-radius: 12px; }
.unit-keyline--hero { border-color: rgba(120, 170, 255, 0.95); }
.unit-keyline--foe { border-color: rgba(235, 70, 75, 0.95); }
.unit-keyline--boss { border-color: rgb(219, 102, 255); }
.unit-keyline--guest { border-color: rgb(110, 240, 160); }

/* ── Orb pips (generic mana) ──────────────────────────────────────────── */
.pip { width: 34px; height: 34px; border-radius: 17px; margin: 0 3px; border-width: 2px; border-color: rgba(255,255,255,0.8); font-size: 20px; -unity-text-align: middle-center; -unity-font-style: bold; color: rgb(20,20,20); }
.pip--mana { background-color: rgb(107, 199, 255); }

/* ── Rarity colors ───────────────────────────────────────────────────────── */
.rarity-Junk { color: rgb(140, 140, 140); }
.rarity-Common { color: rgb(236, 236, 240); }
.rarity-Uncommon { color: rgb(110, 230, 120); }
.rarity-Rare { color: rgb(100, 170, 255); }
.rarity-Epic { color: rgb(200, 120, 255); }
.rarity-Legendary { color: rgb(255, 200, 70); }
